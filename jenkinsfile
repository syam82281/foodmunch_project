pipeline {
    agent any

    stages {

        stage('Clone Code') {
            steps {
                echo 'GitHub Code Cloned'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t foodmunch-app .'
            }
        }

        stage('Run Container') {
            steps {
                sh 'docker run -d -p 8081:80 --name foodmunch-container foodmunch-app || true'
            }
        }

    }
}
